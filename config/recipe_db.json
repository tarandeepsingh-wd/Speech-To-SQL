        "diet": "diet",
        "page": "page",
        "limit": "limit"
      }
    },
    "title": {
      "method": "GET",
      "path": "recipe2-api/recipe-bytitle/recipeByTitle",
      "priority": 80,
      "reason": "Title search fallback from the query text.",
      "params": {
        "title": "title"
      }
    },
    "general": {
      "method": "GET",
      "path": "recipe2-api/recipe/recipesinfo",
      "priority": 999,
      "reason": "No selective endpoint matched.",
      "params": {
        "page": "page",
        "limit": "limit"
      }
    },
    "calories": {
      "method": "GET",
      "path": "recipe2-api/recipes-calories/calories",
      "priority": 30,
      "reason": "Calories endpoint.",
      "params": {
        "min": "minCalories",
        "max": "maxCalories",
        "page": "page",
        "limit": "limit"
      }
    },
    "carbs": {
      "method": "GET",
      "path": "recipe2-api/recipe-carbo/recipes-by-carbs",
      "priority": 32,
      "reason": "Carbohydrate endpoint.",
      "params": {
        "min": "minCarbs",
        "max": "maxCarbs",
        "page": "page",
        "limit": "limit"
      }
    },
    "protein": {
      "method": "GET",
      "path": "recipe2-api/protein/protein-range",
      "priority": 31,
      "reason": "Protein endpoint.",
      "params": {
        "min": "min",
        "max": "max",
        "page": "page",
        "limit": "limit"
      }
    },
    "energy": {
      "method": "GET",
      "path": "recipe2-api/byenergy/energy",
      "priority": 34,
      "reason": "Energy endpoint.",
      "params": {
        "min": "minEnergy",
        "max": "maxEnergy",
        "page": "page",
        "limit": "limit"
      }
    },
    "time_range": {
      "method": "GET",
      "path": "recipe2-api/recipes/range",
      "priority": 40,
      "reason": "Preparation/cook/total time range endpoint.",
      "params": {
        "field": "field",
        "min": "min",
        "max": "max",
        "page": "page",
        "limit": "limit"
      }
    },
    "utensils": {
      "method": "GET",
      "path": "recipe2-api/byutensils/utensils",
      "priority": 45,
      "reason": "Utensil endpoint.",
      "params": {
        "utensils": "utensils",
        "page": "page",
        "limit": "limit"
      }
    }
