  "request": {
    "timeout_seconds": 15,
    "ttl_seconds": 600,
    "max_pages_per_plan": 5,
    "min_interval_seconds": 2.5
  },
  "response": {
    "recipe_list_paths": ["data", "recipes", "payload.data", "payload.recipes"],
