__pycache__/
*.pyc
.pytest_cache/

# Secrets and machine-local environment files.
.env
.env.*
!.env.example

# Local assistant/editor caches are not project artifacts.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# Runtime logs are local; keep the folder note.
logs/*.log
!logs/README.md

# Local model artifacts are generated by training.
src/speech_to_sql/m2_nlu/models/*
!src/speech_to_sql/m2_nlu/models/ingredient_reranker/
!src/speech_to_sql/m2_nlu/models/ingredient_reranker/model.pkl
!src/speech_to_sql/m2_nlu/models/dish_title_classifier/
!src/speech_to_sql/m2_nlu/models/dish_title_classifier/model.pkl

# Feedback logs can contain user queries/corrections.
src/speech_to_sql/m2_nlu/data/feedback/*.jsonl

# Generated verification reports are local evidence, not source artifacts.
docs/verification/

# API probing generates local virtual schema evidence.
data/query_cache/*.json
!data/query_cache/.gitkeep

# Local embedding/phoneme caches are regenerated automatically.
src/speech_to_sql/m2_nlu/data/_cache/

# Downloaded/converted datasets can be large.
src/speech_to_sql/m2_nlu/datasets/raw/*
src/speech_to_sql/m2_nlu/datasets/processed/*.jsonl
!src/speech_to_sql/m2_nlu/datasets/raw/.gitkeep
!src/speech_to_sql/m2_nlu/datasets/processed/.gitkeep
!src/speech_to_sql/m2_nlu/datasets/processed/ingredient_reranker_candidates.jsonl

apps/proxy/node_modules/
apps/web/node_modules/
apps/web/build/

# The SQLite verifier DB is generated by temp_recipe_db/seed_temp_db.py.
temp_recipe_db/recipe_test.db
