{
  "model_name": "distilbert-base-uncased",
  "training": {
    "epochs": 6,
    "batch_size": 16,
    "learning_rate": 0.00003,
    "max_length": 128,
    "synthetic_limit": 5000,
    "train_split": 0.85,
    "random_seed": 42
  },
  "labels": [
    "O",
    "B-CLAUSE", "I-CLAUSE",
    "B-LOGIC", "I-LOGIC",
    "B-COMPARE", "I-COMPARE",
    "B-AGG", "I-AGG",
    "B-SET", "I-SET",
    "B-MODIFY", "I-MODIFY"
  ],
  "tables": ["recipes", "dishes", "meals"],
  "fields": [
    "calories", "protein", "fat", "carbs", "fiber", "sodium", "sugar",
    "prep_time", "cook_time", "servings", "rating", "review_count"
  ],
  "values": ["5", "10", "15", "30", "50", "60", "100", "200", "300", "500", "1000"],
  "templates": [
    "show {table} where {field} is {operator} {value}",
    "find {table} with {field} {operator} {value}",
    "recipes where {field} is less than {value}",
    "recipes where {field} is more than {value}",
    "give me meals with {field} under {value}",
    "show recipes with {field} above {value}",
    "find recipes where {field} is between {value} and {value2}",
    "recipes sorted by {field}",
    "show recipes ordered by {field}",
    "count recipes where {field} {operator} {value}",
    "how many recipes have {field} {operator} {value}",
    "recipes with {field} at most {value}",
    "recipes with {field} at least {value}",
    "average {field} of all recipes",
    "find recipes where {field} is not null",
    "show me the top recipes by {field}",
    "recipes grouped by {field}",
    "find dishes where {field} equals {value}",
    "get recipes with high {field}",
    "get recipes with low {field}"
  ]
}
