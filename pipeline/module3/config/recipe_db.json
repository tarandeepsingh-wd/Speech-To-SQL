{
  "api_key_env": "RDB2_API_KEY",
  "base_url_env": "RDB2_BASE_URL",
  "default_base_url": "http://cosylab.iiitd.edu.in:6969",
  "request": {
    "timeout_seconds": 15,
    "ttl_seconds": 600
  },
  "response": {
    "recipe_list_paths": ["data", "recipes", "payload.data", "payload.recipes"],
    "error_fields": ["message", "error", "detail"]
  },
  "postman_api_key_variable": "apiKey",
  "truthy_values": ["true", "yes", "y", "1"],
  "schema_discovery": {
    "cache_path": "module3/cache/virtual_schema.json",
    "openapi_paths": ["/openapi.json", "/swagger.json", "/api-docs", "/recipe2-api/openapi.json"],
    "probe_limit": 1,
    "probes": [
      {"endpoint": "general", "params": {"page": 1, "limit": 1}},
      {"endpoint": "ingredient_category_title", "params": {"include_ingredients": "spinach", "page": 1, "limit": 1}},
      {"endpoint": "calories", "params": {"min": 0, "max": 300, "page": 1, "limit": 1}},
      {"endpoint": "carbs", "params": {"min": 0, "max": 50, "page": 1, "limit": 1}},
      {"endpoint": "protein", "params": {"min": 10, "max": 50, "page": 1, "limit": 1}},
      {"endpoint": "time_range", "params": {"field": "total_time", "min": 0, "max": 30, "page": 1, "limit": 1}},
      {"endpoint": "diet", "params": {"diet": "vegan", "page": 1, "limit": 1}},
      {"endpoint": "cuisine", "path_values": {"region": "Indian Subcontinent"}, "params": {"continent": "Asian", "sub_region": "Indian", "page": 1, "limit": 1}},
      {"endpoint": "utensils", "params": {"utensils": "bowl", "page": 1, "limit": 1}},
      {"endpoint": "title", "params": {"title": "Chicken"}},
      {"endpoint": "energy", "params": {"min": 0, "max": 800, "page": 1, "limit": 1}}
    ]
  },
  "pagination": {
    "default_page": 1,
    "default_fetch_limit": 100,
    "general_fallback_limit": 50
  },
  "endpoints": {
    "ingredient_category_title": {
      "method": "GET",
      "path": "recipe2-api/recipebyingredient/by-ingredients-categories-title",
      "priority": 10,
      "reason": "Most selective endpoint for ingredient include/exclude, category, and title constraints.",
      "params": {
        "page": "page",
        "limit": "limit",
        "include_ingredients": "includeIngredients",
        "exclude_ingredients": "excludeIngredients",
        "include_categories": "includeCategories",
        "exclude_categories": "excludeCategories",
        "title": "title"
      }
    },
    "region_diet": {
      "method": "GET",
      "path": "recipe2-api/recipe/region-diet/region-diet",
      "priority": 15,
      "reason": "Combined cuisine/region and dietary endpoint.",
      "params": {
        "region": "region",
        "diet": "diet",
        "page": "page",
        "limit": "limit"
      }
    },
    "cuisine": {
      "method": "GET",
      "path_template": "recipe2-api/recipes_cuisine/cuisine/{region}",
      "priority": 25,
      "reason": "Cuisine/region endpoint.",
      "params": {
        "continent": "continent",
        "sub_region": "subRegion",
        "field": "field",
        "min": "min",
        "max": "max",
        "page": "page",
        "limit": "page_size"
      }
    },
    "diet": {
      "method": "GET",
      "path": "recipe2-api/recipe-diet/recipe-diet",
      "priority": 35,
      "reason": "Diet endpoint.",
      "params": {
        "diet": "diet",
        "page": "page",
        "limit": "limit"
      }
    },
    "title": {
      "method": "GET",
      "path": "recipe2-api/recipe-bytitle/recipeByTitle",
      "priority": 80,
      "reason": "Title search fallback from the query text.",
      "params": {
        "title": "title"
      }
    },
    "general": {
      "method": "GET",
      "path": "recipe2-api/recipe/recipesinfo",
      "priority": 999,
      "reason": "No selective endpoint matched.",
      "params": {
        "page": "page",
        "limit": "limit"
      }
    },
    "calories": {
      "method": "GET",
      "path": "recipe2-api/recipes-calories/calories",
      "priority": 30,
      "reason": "Calories endpoint.",
      "params": {
        "min": "minCalories",
        "max": "maxCalories",
        "page": "page",
        "limit": "limit"
      }
    },
    "carbs": {
      "method": "GET",
      "path": "recipe2-api/recipe-carbo/recipes-by-carbs",
      "priority": 32,
      "reason": "Carbohydrate endpoint.",
      "params": {
        "min": "minCarbs",
        "max": "maxCarbs",
        "page": "page",
        "limit": "limit"
      }
    },
    "protein": {
      "method": "GET",
      "path": "recipe2-api/protein/protein-range",
      "priority": 31,
      "reason": "Protein endpoint.",
      "params": {
        "min": "min",
        "max": "max",
        "page": "page",
        "limit": "limit"
      }
    },
    "energy": {
      "method": "GET",
      "path": "recipe2-api/byenergy/energy",
      "priority": 34,
      "reason": "Energy endpoint.",
      "params": {
        "min": "minEnergy",
        "max": "maxEnergy",
        "page": "page",
        "limit": "limit"
      }
    },
    "time_range": {
      "method": "GET",
      "path": "recipe2-api/recipes/range",
      "priority": 40,
      "reason": "Preparation/cook/total time range endpoint.",
      "params": {
        "field": "field",
        "min": "min",
        "max": "max",
        "page": "page",
        "limit": "limit"
      }
    },
    "utensils": {
      "method": "GET",
      "path": "recipe2-api/byutensils/utensils",
      "priority": 45,
      "reason": "Utensil endpoint.",
      "params": {
        "utensils": "utensils",
        "page": "page",
        "limit": "limit"
      }
    }
  },
  "diet_aliases": {
    "vegan": "vegan",
    "vegetarian": "ovo_lacto_vegetarian",
    "ovo-vegetarian": "ovo_vegetarian",
    "lacto-vegetarian": "lacto_vegetarian",
    "pescatarian": "pescetarian",
    "pescetarian": "pescetarian"
  },
  "logic_terms": {
    "or": ["or", "either", "any of"],
    "and": ["and", "with", "plus", "all of"]
  },
  "cuisine_aliases": {
    "african": {"region": "African"},
    "american": {"region": "American"},
    "asian": {"continent": "Asian", "region": "Asian"},
    "australian": {"region": "Australian"},
    "belgian": {"region": "Belgian"},
    "chinese": {"sub_region": "Chinese", "region": "Chinese"},
    "egyptian": {"sub_region": "Egyptian", "region": "Egyptian"},
    "european": {"continent": "European", "region": "European"},
    "french": {"region": "French"},
    "greek": {"region": "Greek"},
    "indian": {"continent": "Asian", "sub_region": "Indian", "region": "Indian Subcontinent"},
    "italian": {"region": "Italian"},
    "japanese": {"sub_region": "Japanese", "region": "Japanese"},
    "korean": {"sub_region": "Korean", "region": "Korean"},
    "lebanese": {"region": "Middle Eastern", "sub_region": "Lebanese"},
    "mediterranean": {"region": "Mediterranean"},
    "mexican": {"region": "Mexican"},
    "middle eastern": {"region": "Middle Eastern"},
    "moroccan": {"sub_region": "Moroccan", "region": "Northern Africa"},
    "thai": {"region": "Thai", "sub_region": "Thai"},
    "vietnamese": {"sub_region": "Vietnamese", "region": "Vietnamese"}
  },
  "time_fields": {
    "default": "total_time",
    "terms": {
      "prep": "prep_time",
      "prepare": "prep_time",
      "preparation": "prep_time",
      "cook": "cook_time",
      "cooking": "cook_time",
      "total": "total_time",
      "time": "total_time",
      "quick": "total_time",
      "fast": "total_time",
      "faster": "total_time"
    },
    "quick_terms": ["quick", "fast", "faster", "quickest", "shortest"],
    "hour_terms": ["hour", "hours", "hr", "hrs"],
    "quick_max_minutes": 30
  },
  "intent_enrichment": {
    "nutrition_qualifiers": [
      {"terms": ["low carb", "low carbohydrate"], "nutrient": "carbs", "operator": "<=", "value": 50},
      {"terms": ["low calorie", "low calories", "low kcal"], "nutrient": "calories", "operator": "<=", "value": 500},
      {"terms": ["high protein", "protein rich"], "nutrient": "protein", "operator": ">=", "value": 20},
      {"terms": ["low sugar", "low sugars", "sugar free", "sugar-free"], "nutrient": "sugar", "operator": "<=", "value": 10}
    ],
    "time_patterns": {
      "between": "\\bbetween\\s+(\\d+(?:\\.\\d+)?)\\s+(?:and|to)\\s+(\\d+(?:\\.\\d+)?)\\s*(?:minutes?|mins?|min|hours?|hrs?|hr)\\b",
      "upper": "\\b(?:under|below|less than|within|at most|max(?:imum)?)\\s+(\\d+(?:\\.\\d+)?)\\s*(?:minutes?|mins?|min|hours?|hrs?|hr)\\b",
      "lower": "\\b(?:over|above|more than|at least|min(?:imum)?)\\s+(\\d+(?:\\.\\d+)?)\\s*(?:minutes?|mins?|min|hours?|hrs?|hr)\\b"
    }
  },
  "category_types": {
    "cuisine": ["region", "cuisine", "continent", "sub_region", "subregion"]
  },
  "response_field_aliases": {
    "calories": ["Calories", "calories"],
    "protein": ["Protein (g)", "protein", "protein_g"],
    "carbs": ["Carbohydrate, by difference (g)", "Carbs", "carbs", "carbs_g"],
    "fat": ["Total lipid (fat) (g)", "Fat", "fat", "fat_g"],
    "fiber": ["Fiber, total dietary (g)", "Fiber", "fiber", "fiber_g"],
    "sugar": ["Sugars, total including NLEA (g)", "Sugar", "sugar", "sugar_g"],
    "sodium": ["Sodium, Na (mg)", "Sodium", "sodium", "sodium_mg"],
    "energy": ["Energy (kcal)", "Energy", "energy"],
    "time": ["total_time", "cook_time", "prep_time"],
    "total_time": ["total_time"],
    "cook_time": ["cook_time"],
    "prep_time": ["prep_time"]
  },
  "identity_fields": ["Recipe_id", "recipe_id", "id", "_id"],
  "dedupe_fallback_fields": {
    "title": ["Recipe_title", "title"],
    "region": ["Region", "region"]
  },
  "search_text_fields": ["Recipe_title", "title", "Ingredients", "ingredients", "ingredient", "phrase"],
  "nested_ingredient_fields": ["ingredient", "name", "phrase"],
  "utensil_fields": ["Utensils", "utensils"],
  "sort_terms": {
    "protein": ["protein"],
    "calories": ["calorie", "calories", "kcal"],
    "carbs": ["carb", "carbs", "carbohydrate"],
    "fat": ["fat"],
    "prep_time": ["prep time", "prepare time", "prepared time", "preparation time", "prep", "prepare", "prepared", "preparation"],
    "cook_time": ["cook time", "cooking time", "cook", "cooking"],
    "total_time": ["total time", "overall time"],
    "time": ["time", "quick", "fast"]
  },
  "sort_cues": [
    "highest",
    "lowest",
    "most",
    "least",
    "maximum",
    "minimum",
    "max",
    "min",
    "ascending",
    "descending",
    "quick",
    "fast",
    "shortest",
    "longest",
    "high protein",
    "low calorie"
  ],
  "sort_direction_cues": {
    "desc": ["highest", "most", "maximum", "max", "descending", "top", "high"],
    "asc": ["lowest", "least", "minimum", "min", "ascending", "low", "quick", "fast", "shortest"]
  },
  "sort_direction_phrases": {
    "desc": ["from most to least", "from highest to lowest", "from greatest to least", "most to least", "highest to lowest", "greatest to least"],
    "asc": ["from least to most", "from lowest to highest", "from least to greatest", "least to most", "lowest to highest", "least to greatest"]
  },
  "protein_desc_cues": ["high protein", "most protein", "highest protein"],
  "sql_order_columns": {
    "protein": "protein_g",
    "calorie": "calories",
    "calories": "calories",
    "carb": "carbs_g",
    "carbs": "carbs_g",
    "fat": "fat_g",
    "time": "total_time",
    "cook": "cook_time",
    "prep": "prep_time"
  },
  "sql": {
    "default_table": "recipes"
  }
}
